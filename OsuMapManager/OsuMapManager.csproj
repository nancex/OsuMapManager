<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>WinExe</OutputType>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>

    <!-- Disable single-file: Realm and SkiaSharp native libs are incompatible -->
    <PublishSingleFile>false</PublishSingleFile>

    <!-- Keep trimming off for Realm reflection -->
    <PublishTrimmed>false</PublishTrimmed>

    <DebugType>none</DebugType>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
    <Nullable>enable</Nullable>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AvaloniaBuildServicesEnabled>false</AvaloniaBuildServicesEnabled>
  </PropertyGroup>

  <ItemGroup>
    <Folder Include="Models\" />
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.0" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.0" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.0" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.0" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Downloader" Version="5.9.4" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.9" />
    <PackageReference Include="Realm" Version="20.1.0" />
    <PackageReference Include="SharpZipLib" Version="1.4.2" />
  </ItemGroup>

  <!-- Ensure Realm native libraries are copied to publish output -->
  <Target Name="CopyRealmNativeLibs" AfterTargets="Publish">
    <ItemGroup>
      <RealmNativeFiles Include="$(PublishDir)runtimes\win-x64\native\realm.dll" />
      <RealmNativeFiles Include="$(PublishDir)runtimes\win-x64\native\librealm.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(RealmNativeFiles)"
          DestinationFolder="$(PublishDir)"
          Condition="Exists('%(Identity)')"
          SkipUnchangedFiles="true" />
  </Target>
</Project>
