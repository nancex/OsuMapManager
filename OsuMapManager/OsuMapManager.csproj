<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>

    <!-- OutputType: WinExe on Windows, Exe on Linux/macOS -->
    <OutputType Condition="$([MSBuild]::IsOSPlatform('Windows'))">WinExe</OutputType>
    <OutputType Condition="!$([MSBuild]::IsOSPlatform('Windows'))">Exe</OutputType>

    <!-- RuntimeIdentifier: specify at build time, e.g. -r win-x64 / -r linux-x64 -->
    <!-- Defaults to win-x64 for backward compatibility -->
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>

    <SelfContained>true</SelfContained>

    <!-- Disable single-file: Realm and SkiaSharp native libs are incompatible -->
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract Condition="$([MSBuild]::IsOSPlatform('Windows'))">true</IncludeNativeLibrariesForSelfExtract>
    <PublishTrimmed>false</PublishTrimmed>

    <!-- Keep trimming off for Realm reflection -->
    <PublishTrimmed>false</PublishTrimmed>

    <DebugType>none</DebugType>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
    <Nullable>enable</Nullable>
    <BuiltInComInteropSupport Condition="$([MSBuild]::IsOSPlatform('Windows'))">true</BuiltInComInteropSupport>
    <AvaloniaBuildServicesEnabled>false</AvaloniaBuildServicesEnabled>
  </PropertyGroup>

  <ItemGroup>
    <Folder Include="Models\" />
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.0" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.0" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.0" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.0" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Downloader" Version="5.9.4" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.9" />
    <PackageReference Include="Realm" Version="20.1.0" />
    <PackageReference Include="SharpZipLib" Version="1.4.2" />
  </ItemGroup>

  <!-- Copy Realm native libraries for the target platform -->
  <Target Name="CopyRealmNativeLibs" AfterTargets="Publish">
    <!-- Windows -->
    <ItemGroup Condition="$(RuntimeIdentifier.StartsWith('win'))">
      <RealmNativeFiles Include="$(PublishDir)runtimes\$(RuntimeIdentifier)\native\realm.dll" />
      <RealmNativeFiles Include="$(PublishDir)runtimes\$(RuntimeIdentifier)\native\librealm.dll" />
    </ItemGroup>
    <!-- Linux -->
    <ItemGroup Condition="$(RuntimeIdentifier.StartsWith('linux'))">
      <RealmNativeFiles Include="$(PublishDir)runtimes\$(RuntimeIdentifier)\native\librealm.so" />
    </ItemGroup>
    <!-- macOS -->
    <ItemGroup Condition="$(RuntimeIdentifier.StartsWith('osx'))">
      <RealmNativeFiles Include="$(PublishDir)runtimes\$(RuntimeIdentifier)\native\librealm.dylib" />
    </ItemGroup>
    <Copy SourceFiles="@(RealmNativeFiles)"
          DestinationFolder="$(PublishDir)"
          Condition="Exists('%(Identity)')"
          SkipUnchangedFiles="true" />
  </Target>
</Project>
