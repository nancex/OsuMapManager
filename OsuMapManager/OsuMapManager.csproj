<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>

    <!-- OutputType: WinExe on Windows, Exe on Linux/macOS -->
    <OutputType Condition="$([MSBuild]::IsOSPlatform('Windows'))">WinExe</OutputType>
    <OutputType Condition="!$([MSBuild]::IsOSPlatform('Windows'))">Exe</OutputType>

    <!-- Supported runtime identifiers. Build with -r <rid>, e.g. dotnet publish -r linux-x64 -->
    <!-- win-x64 | win-arm64 | linux-x64 | linux-arm64 | osx-x64 | osx-arm64 -->

    <!-- Default RID when not specified (dev convenience) -->
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>

    <SelfContained>true</SelfContained>

    <!-- Single-file publish: native libs (Realm, SkiaSharp) are extracted at runtime via IncludeNativeLibrariesForSelfExtract -->
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>

    <!-- Trimming is off: Realm and CommunityToolkit.Mvvm use reflection heavily -->
    <PublishTrimmed>false</PublishTrimmed>

    <!-- Release-only size optimizations -->
    <DebuggerSupport Condition="'$(Configuration)' == 'Release'">false</DebuggerSupport>
    <EventSourceSupport Condition="'$(Configuration)' == 'Release'">false</EventSourceSupport>
    <UseSystemResourceKeys Condition="'$(Configuration)' == 'Release'">true</UseSystemResourceKeys>


    <PublishReadyToRun>false</PublishReadyToRun>

    <DebugType>none</DebugType>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
    <Nullable>enable</Nullable>
    <BuiltInComInteropSupport Condition="$([MSBuild]::IsOSPlatform('Windows'))">true</BuiltInComInteropSupport>
    <AvaloniaBuildServicesEnabled>false</AvaloniaBuildServicesEnabled>
  </PropertyGroup>

  <ItemGroup>
    <Folder Include="Models\" />
    <AvaloniaResource Include="Assets\**" />
    <EmbeddedResource Include="..\VERSION" Link="VERSION" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.0" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.0" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.0" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.0" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Downloader" Version="5.9.4" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.9" />
    <PackageReference Include="Realm" Version="20.1.0" />
    <PackageReference Include="SharpZipLib" Version="1.4.2" />
  </ItemGroup>

  <!-- Copy Realm native libraries to publish root -->
  <Target Name="CopyRealmNativeLibs" AfterTargets="Publish">
    <!-- Windows -->
    <ItemGroup Condition="$(RuntimeIdentifier.StartsWith('win'))">
      <RealmNativeFiles Include="$(PublishDir)runtimes\$(RuntimeIdentifier)\native\realm.dll" />
      <RealmNativeFiles Include="$(PublishDir)runtimes\$(RuntimeIdentifier)\native\librealm.dll" />
    </ItemGroup>
    <!-- Linux -->
    <ItemGroup Condition="$(RuntimeIdentifier.StartsWith('linux'))">
      <RealmNativeFiles Include="$(PublishDir)runtimes\$(RuntimeIdentifier)\native\librealm.so" />
    </ItemGroup>
    <!-- macOS -->
    <ItemGroup Condition="$(RuntimeIdentifier.StartsWith('osx'))">
      <RealmNativeFiles Include="$(PublishDir)runtimes\$(RuntimeIdentifier)\native\librealm.dylib" />
    </ItemGroup>
    <Copy SourceFiles="@(RealmNativeFiles)"
          DestinationFolder="$(PublishDir)"
          Condition="Exists('%(Identity)')"
          SkipUnchangedFiles="true" />
  </Target>
</Project>