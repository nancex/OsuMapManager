<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:OsuMapManager.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="720"
        x:Class="OsuMapManager.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="OsuMapManager - osu! Beatmap Manager"
        Width="1100" Height="720"
        MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="Transparent">

    <Window.Styles>
        <Style Selector="Border.Card">
            <Setter Property="Background" Value="#28FFFFFF" />
            <Setter Property="BorderBrush" Value="#18FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="20" />
            <Setter Property="BoxShadow" Value="0 4 24 #00000030" />
        </Style>

        <Style Selector="Border.SidebarCard">
            <Setter Property="Background" Value="#18FFFFFF" />
            <Setter Property="BorderBrush" Value="#18FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="16" />
        </Style>

        <Style Selector="Button.NavButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#B0FFFFFF" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="20,10" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.NavButton:pointerover">
            <Setter Property="Background" Value="#15FFFFFF" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Button.NavButton.Selected">
            <Setter Property="Background" Value="#FF6ECF" />
            <Setter Property="Foreground" Value="White" />
        </Style>

        <Style Selector="Button.Primary">
            <Setter Property="Background" Value="#FF6ECF" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="24,10" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.Primary:pointerover">
            <Setter Property="Background" Value="#FF8DFF" />
        </Style>

        <Style Selector="Button.Secondary">
            <Setter Property="Background" Value="#15FFFFFF" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="20,10" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.Secondary:pointerover">
            <Setter Property="Background" Value="#25FFFFFF" />
        </Style>

        <Style Selector="Button.Danger">
            <Setter Property="Background" Value="#FF6B6B" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="24,10" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style Selector="CheckBox">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <Style Selector="Slider">
            <Setter Property="Foreground" Value="#FF6ECF" />
        </Style>

        <Style Selector="ProgressBar">
            <Setter Property="Foreground" Value="#FF6ECF" />
            <Setter Property="Background" Value="#28FFFFFF" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>

        <Style Selector="TextBlock.H1">
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="TextBlock.H2">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="TextBlock.Body">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="#B0FFFFFF" />
        </Style>
        <Style Selector="TextBlock.Muted">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#70FFFFFF" />
        </Style>

        <Style Selector="TextBox">
            <Setter Property="Background" Value="#15FFFFFF" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#18FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <Style Selector="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="ListBoxItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
        <Style Selector="ListBoxItem:pointerover">
            <Setter Property="Background" Value="#10FFFFFF" />
        </Style>
        <Style Selector="ListBoxItem:selected">
            <Setter Property="Background" Value="#20FFFFFF" />
        </Style>
    </Window.Styles>

    <Panel>
        <Border CornerRadius="0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#1a1a2e" Offset="0" />
                    <GradientStop Color="#16213e" Offset="0.5" />
                    <GradientStop Color="#0f3460" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <Grid RowDefinitions="Auto,*" Margin="0">
                <Border Grid.Row="0" Margin="16,8,16,0" Padding="4"
                        Background="#18FFFFFF" BorderBrush="#18FFFFFF"
                        BorderThickness="1" CornerRadius="10">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="NavSync" Content="Sync" Classes="NavButton Selected" Click="Nav_Click" Tag="0" Margin="0,0,4,0" />
                        <Button x:Name="NavImportExport" Content="Import / Export" Classes="NavButton" Click="Nav_Click" Tag="1" Margin="0,0,4,0" />
                        <Button x:Name="NavSettings" Content="Settings" Classes="NavButton" Click="Nav_Click" Tag="2" />
                    </StackPanel>
                </Border>

                <Grid Grid.Row="1" Margin="16,8,16,16">

                    <!-- ============== SYNC VIEW ============== -->
                    <Grid x:Name="SyncView" IsVisible="True" ColumnDefinitions="280,*" ColumnSpacing="16">

                        <Border Grid.Column="0" Classes="SidebarCard" VerticalAlignment="Stretch">
                            <Grid RowDefinitions="Auto,Auto,Auto,Auto,*">
                                <Border Grid.Row="0" Height="120" Background="#10FFFFFF" CornerRadius="10" Margin="0,0,0,8">
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock Text="osu!" FontSize="36" FontWeight="Bold"
                                                   Foreground="#FF6ECF" HorizontalAlignment="Center" />
                                        <TextBlock Text="Map Manager" FontSize="12"
                                                   Foreground="#70FFFFFF" HorizontalAlignment="Center" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>

                                <Button Grid.Row="1" Content="Start Sync" Classes="Primary"
                                        HorizontalAlignment="Stretch"
                                        Command="{Binding SyncVm.StartSyncCommand}"
                                        IsEnabled="{Binding !SyncVm.IsSyncing}" Margin="0,0,0,12" />

                                <Border Grid.Row="2" Background="#10FFFFFF" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="Local Stats" Classes="Body" FontWeight="SemiBold" Margin="0,0,0,6" />
                                        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,4">
                                            <TextBlock Text="Sets:" Classes="Muted" />
                                            <TextBlock Grid.Column="1" Text="{Binding SyncVm.LocalBeatmapCount}"
                                                       Classes="Body" FontWeight="Bold" Foreground="#FF6ECF" />
                                        </Grid>
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Text="Size:" Classes="Muted" />
                                            <TextBlock Grid.Column="1" Text="{Binding SyncVm.LocalTotalSize}"
                                                       Classes="Body" FontWeight="Bold" Foreground="#FF6ECF" />
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Row="3" Background="#10FFFFFF" CornerRadius="8" Padding="14"
                                        IsVisible="{Binding SyncVm.IsSyncing}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding SyncVm.SyncStatusText}" Classes="Body" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,8" />
                                        <ProgressBar Value="{Binding SyncVm.SyncProgress}" Minimum="0" Maximum="100" Height="6" Margin="0,0,0,4" />
                                        <TextBlock Text="{Binding SyncVm.SyncDetailText}" Classes="Muted" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <ScrollViewer Grid.Column="1">
                            <StackPanel>
                                <!-- Genre Card -->
                                <Border Classes="Card" Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="Genre" Classes="H2" Margin="0,0,0,10" />
                                        <CheckBox Content="Select All" IsChecked="{Binding SyncVm.AllGenresSelected}" Margin="0,0,0,6" />
                                        <ItemsControl ItemsSource="{Binding SyncVm.Genres}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:GenreItem">
                                                    <CheckBox Content="{Binding DisplayName}" IsChecked="{Binding IsSelected}" Margin="0,0,10,6" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <!-- Year Card -->
                                <Border Classes="Card" Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="Release Year" Classes="H2" Margin="0,0,0,10" />
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                            <TextBlock Grid.Column="0" Text="{Binding SyncVm.YearFrom}" Classes="Body" VerticalAlignment="Center" MinWidth="40" />
                                            <Slider Grid.Column="1" Minimum="{Binding SyncVm.MinYear}" Maximum="{Binding SyncVm.MaxYear}" Value="{Binding SyncVm.YearFrom}" />
                                            <TextBlock Grid.Column="2" Text="{Binding SyncVm.YearTo}" Classes="Body" VerticalAlignment="Center" MinWidth="40" />
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Status Card -->
                                <Border Classes="Card" Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="Status" Classes="H2" Margin="0,0,0,10" />
                                        <WrapPanel>
                                            <CheckBox Content="Ranked" IsChecked="{Binding SyncVm.IncludeRanked}" Margin="0,0,16,8" />
                                            <CheckBox Content="Approved" IsChecked="{Binding SyncVm.IncludeApproved}" Margin="0,0,16,8" />
                                            <CheckBox Content="Qualified" IsChecked="{Binding SyncVm.IncludeQualified}" Margin="0,0,16,8" />
                                            <CheckBox Content="Loved" IsChecked="{Binding SyncVm.IncludeLoved}" Margin="0,0,16,8" />
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Game Mode Card -->
                                <Border Classes="Card" Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="Game Mode" Classes="H2" Margin="0,0,0,10" />
                                        <WrapPanel>
                                            <CheckBox Content="osu!" IsChecked="{Binding SyncVm.OsuMode}" Margin="0,0,16,8" />
                                            <CheckBox Content="Taiko" IsChecked="{Binding SyncVm.TaikoMode}" Margin="0,0,16,8" />
                                            <CheckBox Content="Catch" IsChecked="{Binding SyncVm.CatchMode}" Margin="0,0,16,8" />
                                            <CheckBox Content="Mania" IsChecked="{Binding SyncVm.ManiaMode}" Margin="0,0,16,8" />
                                        </WrapPanel>
                                        <StackPanel IsVisible="{Binding SyncVm.IsManiaSelected}" Margin="0,4,0,0">
                                            <TextBlock Text="Mania Key Count:" Classes="Body" Margin="0,0,0,6" />
                                            <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="10">
                                                <TextBlock Text="{Binding SyncVm.ManiaKeyCount}" Classes="Body" FontWeight="Bold" VerticalAlignment="Center" MinWidth="24" />
                                                <Slider Grid.Column="1" Width="200" Minimum="1" Maximum="18" Value="{Binding SyncVm.ManiaKeyCount}" />
                                            </Grid>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Confirm Dialog -->
                                <Border Classes="Card" IsVisible="{Binding SyncVm.ShowSyncConfirm}" Background="#30FFFFFF" Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="Sync Confirmation" Classes="H2" Margin="0,0,0,12" />
                                        <TextBlock Text="{Binding SyncVm.SyncConfirmMessage}" Classes="Body" TextWrapping="Wrap" Margin="0,0,0,12" />
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button Content="Cancel" Classes="Secondary" Command="{Binding SyncVm.CancelSyncCommand}" Margin="0,0,10,0" />
                                            <Button Content="Continue" Classes="Primary" Command="{Binding SyncVm.ContinueSyncCommand}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Extra Prompt -->
                                <Border Classes="Card" IsVisible="{Binding SyncVm.ShowExtraPrompt}" Background="#15FF6B6B">
                                    <StackPanel>
                                        <TextBlock Text="Clean Up" Classes="H2" Margin="0,0,0,12" />
                                        <TextBlock Text="{Binding SyncVm.ExtraPromptMessage}" Classes="Body" TextWrapping="Wrap" Margin="0,0,0,12" />
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button Content="Keep All" Classes="Secondary" Command="{Binding SyncVm.DismissExtraPromptCommand}" Margin="0,0,10,0" />
                                            <Button Content="Delete Extra" Classes="Danger" Command="{Binding SyncVm.DeleteExtraCommand}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- ============== IMPORT/EXPORT VIEW ============== -->
                    <Grid x:Name="ImportExportView" IsVisible="False" ColumnDefinitions="200,*" ColumnSpacing="16">

                        <Border Grid.Column="0" Classes="SidebarCard" VerticalAlignment="Stretch">
                            <StackPanel>
                                <Button x:Name="IeImportBtn" Content="Import" Classes="NavButton Selected" Click="IeNav_Click" Tag="import" Margin="0,0,0,6" />
                                <Button x:Name="IeExportBtn" Content="Export" Classes="NavButton" Click="IeNav_Click" Tag="export" />
                            </StackPanel>
                        </Border>

                        <Grid Grid.Column="1">
                            <Grid x:Name="ImportMode" IsVisible="True" RowDefinitions="*,Auto">
                                <Border Grid.Row="0" Classes="Card" VerticalAlignment="Top">
                                    <StackPanel>
                                        <TextBlock Text="Import Collections" Classes="H2" Margin="0,0,0,10" />
                                        <TextBlock Text="Select a .txt or .zip file to import collections." Classes="Body" TextWrapping="Wrap" Margin="0,0,0,16" />
                                        <Border Background="#10FFFFFF" CornerRadius="8" Padding="20" BorderBrush="#18FFFFFF" BorderThickness="1">
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="?" FontSize="40" HorizontalAlignment="Center" Margin="0,0,0,10" />
                                                <Button Content="Browse Files..." Classes="Secondary" Command="{Binding ImportExportVm.BrowseImportFileCommand}" Margin="0,0,0,8" />
                                                <TextBlock Text="{Binding ImportExportVm.ImportFilePath}" Classes="Muted" TextWrapping="Wrap" MaxWidth="400" />
                                            </StackPanel>
                                        </Border>
                                        <TextBlock Text="{Binding ImportExportVm.ImportStatus}" Classes="Body" TextWrapping="Wrap"
                                                   Foreground="#FF6ECF" Margin="0,10,0,0"
                                                   IsVisible="{Binding ImportExportVm.ImportStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Row="1" Padding="0,16,0,0">
                                    <Button Content="Import" Classes="Primary" HorizontalAlignment="Right"
                                            Command="{Binding ImportExportVm.ImportCommand}"
                                            IsEnabled="{Binding !ImportExportVm.IsImporting}" />
                                </Border>
                            </Grid>

                            <Grid x:Name="ExportMode" IsVisible="False" RowDefinitions="*,Auto,Auto">
                                <Border Grid.Row="0" Classes="Card" VerticalAlignment="Stretch">
                                    <Grid RowDefinitions="Auto,*,Auto">
                                        <StackPanel Grid.Row="0" Margin="0,0,0,12">
                                            <TextBlock Text="Export Collections" Classes="H2" Margin="0,0,0,6" />
                                            <TextBlock Text="Select collections to export. Multi-select supported." Classes="Body" Margin="0,0,0,6" />
                                            <Button Content="Refresh List" Classes="Secondary" HorizontalAlignment="Left"
                                                    Command="{Binding ImportExportVm.LoadCollectionsCommand}" />
                                        </StackPanel>
                                        <ScrollViewer Grid.Row="1">
                                            <ListBox ItemsSource="{Binding ImportExportVm.Collections}" SelectionMode="Multiple">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:CollectionItem">
                                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                                            <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center" />
                                                            <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" FontSize="14" Foreground="White" />
                                                            <Border Grid.Column="2" Background="#15FFFFFF" CornerRadius="4" Padding="8,2">
                                                                <TextBlock Text="{Binding BeatmapCount, StringFormat={}{0} maps}" Classes="Muted" />
                                                            </Border>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </ScrollViewer>
                                        <TextBlock Grid.Row="2" Text="{Binding ImportExportVm.ExportStatus}" Classes="Body" TextWrapping="Wrap"
                                                   Foreground="#FF6ECF" Margin="0,6,0,0" />
                                    </Grid>
                                </Border>
                                <Border Grid.Row="1" Padding="0,16,0,0">
                                    <Button Content="Export..." Classes="Primary" HorizontalAlignment="Right"
                                            Command="{Binding ImportExportVm.ShowExportDialogCommand}"
                                            IsEnabled="{Binding !ImportExportVm.IsExporting}" />
                                </Border>                                 <Border Grid.Row="2" Classes="Card" IsVisible="{Binding ImportExportVm.ShowExportFormatDialog}"
                                         Background="#30FFFFFF" Margin="0,16,0,0">
                                     <StackPanel>
                                         <TextBlock Text="Choose Export Format" Classes="H2" Margin="0,0,0,12" />
                                         <TextBlock Text="Select the format for your collection export:" Classes="Body" Margin="0,0,0,16" />
                                         <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                             <Button Content="Cancel" Classes="Secondary"
                                                     Command="{Binding ImportExportVm.CancelExportDialogCommand}"
                                                     Margin="0,0,10,0" />
                                             <Button Content="Export as TXT" Classes="Secondary"
                                                     Command="{Binding ImportExportVm.ExportAsTxtCommand}"
                                                     Margin="0,0,10,0" />
                                             <Button Content="Export as ZIP" Classes="Primary"
                                                     Command="{Binding ImportExportVm.ExportAsZipCommand}" />
                                         </StackPanel>
                                     </StackPanel>
                                 </Border>
                            </Grid>
                        </Grid>
                    </Grid>

                    <!-- ============== SETTINGS VIEW ============== -->
                    <ScrollViewer x:Name="SettingsView" IsVisible="False">
                        <StackPanel MaxWidth="700">
                            <Border Classes="Card" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="osu! Installation Path" Classes="H2" Margin="0,0,0,10" />
                                    <TextBlock Text="Select your osu! lazer installation folder." Classes="Body" Margin="0,0,0,10" />
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                        <TextBox Text="{Binding SettingsVm.OsuInstallPath}" PlaceholderText="C:\Users\You\AppData\Local\osu" />
                                        <Button Grid.Column="1" Content="Browse..." Classes="Secondary" Command="{Binding SettingsVm.BrowseOsuPathCommand}" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Classes="Card" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="Download Threads" Classes="H2" Margin="0,0,0,10" />
                                    <TextBlock Text="Number of concurrent download threads." Classes="Body" Margin="0,0,0,10" />
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                        <TextBlock Text="{Binding SettingsVm.DownloadThreads}" Classes="Body" FontWeight="Bold" VerticalAlignment="Center" MinWidth="24" />
                                        <Slider Grid.Column="1" Width="200" Minimum="1" Maximum="16" Value="{Binding SettingsVm.DownloadThreads}" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Classes="Card" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="Beatmap Data" Classes="H2" Margin="0,0,0,10" />
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                        <TextBlock Text="Status:" Classes="Body" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding SettingsVm.IsBeatmapDataReady, StringFormat=Ready: {0}}" Classes="Body" VerticalAlignment="Center" />
                                        <Button Grid.Column="2" Content="Fetch Data" Classes="Secondary"
                                                Command="{Binding SettingsVm.FetchBeatmapDataCommand}"
                                                IsEnabled="{Binding !SettingsVm.IsFetchingData}" />
                                    </Grid>
                                    <StackPanel IsVisible="{Binding SettingsVm.IsFetchingData}" Margin="0,6,0,0">
                                        <ProgressBar Value="{Binding SettingsVm.FetchProgress}" Minimum="0" Maximum="100" Height="6" Margin="0,0,0,4" />
                                        <TextBlock Text="{Binding SettingsVm.FetchProgressText}" Classes="Muted" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Classes="Card" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="Download Source" Classes="H2" Margin="0,0,0,10" />
                                    <TextBlock Text="Choose where to download beatmaps from." Classes="Body" Margin="0,0,0,10" />
                                    <RadioButton Content="Official (osu.ppy.sh)" IsChecked="{Binding SettingsVm.UseOfficialSource}" Margin="0,0,0,6" />
                                    <RadioButton Content="Mirror (catboy.best)" IsChecked="{Binding SettingsVm.UseCatboyMirror}" />
                                </StackPanel>
                            </Border>

                            <Button Content="Save Settings" Classes="Primary" HorizontalAlignment="Right" Command="{Binding SettingsVm.SaveSettingsCommand}" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        

        <!-- Status Bar -->
        <Border VerticalAlignment="Bottom" Height="28" Background="#10000000" Padding="12,0">
            <TextBlock Text="{Binding StatusMessage}" Classes="Muted" VerticalAlignment="Center" />
        </Border>
    </Panel>
</Window>

