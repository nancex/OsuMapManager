<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:OsuMapManager.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="720"
        x:Class="OsuMapManager.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="OsuMapManager - osu! Beatmap Manager"
        Width="1100" Height="720"
        MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="Transparent">

    <Window.Styles>
        <Style Selector="Border.Card">
            <Setter Property="Background" Value="#28FFFFFF" />
            <Setter Property="BorderBrush" Value="#18FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="20" />
            <Setter Property="BoxShadow" Value="0 4 24 #00000030" />
        </Style>

        <Style Selector="Border.SidebarCard">
            <Setter Property="Background" Value="#18FFFFFF" />
            <Setter Property="BorderBrush" Value="#18FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="16" />
        </Style>

        <Style Selector="Button.NavButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#B0FFFFFF" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="20,10" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.NavButton:pointerover">
            <Setter Property="Background" Value="#15FFFFFF" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Button.NavButton.Selected">
            <Setter Property="Background" Value="#FF6ECF" />
            <Setter Property="Foreground" Value="White" />
        </Style>

        <Style Selector="Button.Primary">
            <Setter Property="Background" Value="#FF6ECF" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="24,10" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.Primary:pointerover">
            <Setter Property="Background" Value="#FF8DFF" />
        </Style>

        <Style Selector="Button.Secondary">
            <Setter Property="Background" Value="#15FFFFFF" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="20,10" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.Secondary:pointerover">
            <Setter Property="Background" Value="#25FFFFFF" />
        </Style>

        <Style Selector="Button.Danger">
            <Setter Property="Background" Value="#FF6B6B" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="24,10" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style Selector="CheckBox">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <Style Selector="Slider">
            <Setter Property="Foreground" Value="#FF6ECF" />
        </Style>

        <Style Selector="ProgressBar">
            <Setter Property="Foreground" Value="#FF6ECF" />
            <Setter Property="Background" Value="#28FFFFFF" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>

        <Style Selector="TextBlock.H1">
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="TextBlock.H2">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="TextBlock.Body">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="#B0FFFFFF" />
        </Style>
        <Style Selector="TextBlock.Muted">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#70FFFFFF" />
        </Style>

        <Style Selector="TextBox">
            <Setter Property="Background" Value="#15FFFFFF" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#18FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <Style Selector="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="ListBoxItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
        <Style Selector="ListBoxItem:pointerover">
            <Setter Property="Background" Value="#10FFFFFF" />
        </Style>
        <Style Selector="ListBoxItem:selected">
            <Setter Property="Background" Value="#20FFFFFF" />
        </Style>
    </Window.Styles>

    <Panel>
        <Border CornerRadius="0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#1a1a2e" Offset="0" />
                    <GradientStop Color="#16213e" Offset="0.5" />
                    <GradientStop Color="#0f3460" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <Grid RowDefinitions="Auto,*" Margin="0">
                <Border Grid.Row="0" Margin="16,8,16,0" Padding="4"
                        Background="#18FFFFFF" BorderBrush="#18FFFFFF"
                        BorderThickness="1" CornerRadius="10">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="NavSync" Content="Sync" Classes="NavButton Selected" Click="Nav_Click" Tag="0" Margin="0,0,4,0" />
                        <Button x:Name="NavImportExport" Content="Import / Export" Classes="NavButton" Click="Nav_Click" Tag="1" Margin="0,0,4,0" />
                        <Button x:Name="NavSettings" Content="Settings" Classes="NavButton" Click="Nav_Click" Tag="2" />
                    </StackPanel>
                </Border>

                <Grid Grid.Row="1" Margin="16,8,16,16">

                    <!-- ============== SYNC VIEW ============== -->
                    <Grid x:Name="SyncView" IsVisible="True" ColumnDefinitions="280,*" ColumnSpacing="16">
                        <!-- ===== LEFT SIDEBAR (fixed) ===== -->
                        <Border Grid.Column="0" Classes="SidebarCard" VerticalAlignment="Stretch">
                            <StackPanel>
                                <!-- Local Stats -->
                                <TextBlock Text="Local Stats" Classes="H2" />
                                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" RowSpacing="6" ColumnSpacing="12" Margin="0,10,0,0">
                                    <TextBlock Text="Beatmap Sets:" Classes="Body" />
                                    <TextBlock Grid.Column="1" Text="{Binding SyncVm.LocalBeatmapCount}" Classes="Body" FontWeight="Bold" />
                                    <TextBlock Grid.Row="1" Text="Total Size:" Classes="Body" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SyncVm.LocalTotalSize}" Classes="Body" FontWeight="Bold" />
                                </Grid>

                                <!-- Start Sync Button -->
                                <Button Content="Start Sync" Classes="Primary" Margin="0,16,0,8"
                                        Command="{Binding SyncVm.StartSyncCommand}" />

                                <!-- Check Status Button -->
                                <Button Content="Check Status" Classes="Secondary" Margin="0,0,0,8"
                                        Command="{Binding SyncVm.CheckStatusCommand}" />

                                <!-- Sync Status -->
                                <Border Background="#15FFFFFF" CornerRadius="8" Padding="12"
                                        IsVisible="{Binding SyncVm.IsSyncing}" Margin="0,0,0,8">
                                    <StackPanel>
                                        <TextBlock Text="{Binding SyncVm.SyncStatusText}" Classes="Body" TextWrapping="Wrap" />
                                        <ProgressBar Value="{Binding SyncVm.SyncProgress}" Height="6" Margin="0,6,0,0"
                                                     Minimum="0" Maximum="100" />
                                        <TextBlock Text="{Binding SyncVm.SyncDetailText}" Classes="Muted" Margin="0,4,0,0" />
                                        <Button Content="Cancel" Classes="Danger" Margin="0,8,0,0"
                                                Command="{Binding SyncVm.CancelSyncCommand}" />
                                    </StackPanel>
                                </Border>

                                <!-- Sync Confirm -->
                                <Border Background="#28FF6ECF" CornerRadius="8" Padding="12"
                                        IsVisible="{Binding SyncVm.ShowSyncConfirm}" Margin="0,0,0,8">
                                    <StackPanel>
                                        <TextBlock Text="{Binding SyncVm.SyncConfirmMessage}" Classes="Body" TextWrapping="Wrap" />
                                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0" Spacing="8">
                                            <Button Content="Continue" Classes="Primary"
                                                    Command="{Binding SyncVm.ContinueSyncCommand}" />
                                            <Button Content="Cancel" Classes="Secondary"
                                                    Command="{Binding SyncVm.CancelSyncCommand}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Filter Statuses (Check Status results) -->
                                <StackPanel IsVisible="{Binding SyncVm.HasFilterStatuses}" Margin="0,8,0,0">
                                    <TextBlock Text="{Binding SyncVm.CheckStatusText}" Classes="Muted" Margin="0,0,0,6" />
                                    <ItemsControl ItemsSource="{Binding SyncVm.FilterStatuses}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#15FFFFFF" CornerRadius="6" Padding="8,6" Margin="0,2">
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <TextBlock Text="{Binding FilterName}" Classes="Body" FontWeight="SemiBold" />
                                                        <TextBlock Grid.Column="1" Text="{Binding DisplayText}" Classes="Body" FontWeight="Bold" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- ===== RIGHT SIDE: Big Filters (scrollable) ===== -->
                        <ScrollViewer Grid.Column="1">
                            <StackPanel>
                                <!-- Header -->
                                <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,12">
                                    <TextBlock Text="Big Filters" Classes="H1" VerticalAlignment="Center" />
                                    <Button Grid.Column="1" Content="+ Add Filter" Classes="Primary"
                                            Command="{Binding SyncVm.AddBigFilterCommand}" />
                                </Grid>

                                <!-- Big Filter Cards -->
                                <ItemsControl ItemsSource="{Binding SyncVm.BigFilters}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Classes="Card" Margin="0,0,0,12" Padding="16">
                                                <StackPanel>
                                                    <!-- Header bar -->
                                                    <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,8">
                                                        <TextBox Text="{Binding Name}" Classes="H2" 
                                                                 Background="Transparent" BorderThickness="0"
                                                                 Padding="0" />
                                                        <Button Grid.Column="1" Content="Collapse/Expand" Classes="Secondary" 
                                                                Margin="0,0,6,0" Padding="10,4"
                                                                Command="{Binding ToggleCollapseCommand}" />
                                                        <Button Grid.Column="2" Content="X" Classes="Danger" 
                                                                Padding="10,4"
                                                                Command="{Binding $parent[ItemsControl].DataContext.SyncVm.DeleteBigFilterCommand}"
                                                                CommandParameter="{Binding}" />
                                                    </Grid>

                                                    <!-- Collapsible content -->
                                                    <StackPanel IsVisible="{Binding !IsCollapsed}" Spacing="8">

                                                        <!-- Genre sub-card -->
                                                        <Border Background="#15FFFFFF" CornerRadius="8" Padding="12">
                                                            <StackPanel>
                                                                <TextBlock Text="Genre" Classes="Body" FontWeight="Bold" Margin="0,0,0,6" />
                                                                <CheckBox Content="All" IsChecked="{Binding AllGenresSelected}" Margin="0,0,0,4" />
                                                                <ItemsControl ItemsSource="{Binding Genres}">
                                                                    <ItemsControl.ItemsPanel>
                                                                        <ItemsPanelTemplate>
                                                                            <WrapPanel />
                                                                        </ItemsPanelTemplate>
                                                                    </ItemsControl.ItemsPanel>
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <CheckBox Content="{Binding DisplayName}" IsChecked="{Binding IsSelected}" Margin="0,0,12,4" />
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                            </StackPanel>
                                                        </Border>

                                                        <!-- Submit Date sub-card -->
                                                        <Border Background="#15FFFFFF" CornerRadius="8" Padding="12">
                                                            <StackPanel>
                                                                <TextBlock Text="Submit Date" Classes="Body" FontWeight="Bold" Margin="0,0,0,6" />
                                                                <Grid ColumnDefinitions="Auto,*,Auto,*" ColumnSpacing="8" RowSpacing="4">
                                                                    <TextBlock Text="From:" VerticalAlignment="Center" Classes="Body" />
                                                                    <DatePicker Grid.Column="1" SelectedDate="{Binding SubmitDateFrom}" />
                                                                    <TextBlock Grid.Column="2" Text="To:" VerticalAlignment="Center" Classes="Body" />
                                                                    <DatePicker Grid.Column="3" SelectedDate="{Binding SubmitDateTo}" />
                                                                </Grid>
                                                            </StackPanel>
                                                        </Border>

                                                        <!-- Difficulty Rating sub-card -->
                                                        <Border Background="#15FFFFFF" CornerRadius="8" Padding="12">
                                                            <StackPanel>
                                                                <TextBlock Text="Difficulty Rating" Classes="Body" FontWeight="Bold" Margin="0,0,0,6" />
                                                                <Grid ColumnDefinitions="Auto,80,Auto,80" ColumnSpacing="8">
                                                                    <TextBlock Text="Min:" VerticalAlignment="Center" Classes="Body" />
                                                                    <TextBox Grid.Column="1" Text="{Binding DifficultyRatingMin, TargetNullValue=''}"
                                                                             PlaceholderText="0.0" />
                                                                    <TextBlock Grid.Column="2" Text="Max:" VerticalAlignment="Center" Classes="Body" />
                                                                    <TextBox Grid.Column="3" Text="{Binding DifficultyRatingMax, TargetNullValue=''}"
                                                                             PlaceholderText="10.0" />
                                                                </Grid>
                                                            </StackPanel>
                                                        </Border>

                                                        <!-- Artist / Creator sub-card -->
                                                        <Border Background="#15FFFFFF" CornerRadius="8" Padding="12">
                                                            <StackPanel>
                                                                <TextBlock Text="Artist / Creator" Classes="Body" FontWeight="Bold" Margin="0,0,0,6" />
                                                                <Grid ColumnDefinitions="Auto,*,Auto,*" ColumnSpacing="8">
                                                                    <TextBlock Text="Artist:" VerticalAlignment="Center" Classes="Body" />
                                                                    <TextBox Grid.Column="1" Text="{Binding Artist}" PlaceholderText="contains..." />
                                                                    <TextBlock Grid.Column="2" Text="Creator:" VerticalAlignment="Center" Classes="Body" />
                                                                    <TextBox Grid.Column="3" Text="{Binding Creator}" PlaceholderText="contains..." />
                                                                </Grid>
                                                                <TextBlock Text="Case-insensitive, partial match" Classes="Muted" Margin="0,2,0,0" />
                                                            </StackPanel>
                                                        </Border>

                                                        <!-- Status sub-card -->
                                                        <Border Background="#15FFFFFF" CornerRadius="8" Padding="12">
                                                            <StackPanel>
                                                                <TextBlock Text="Status" Classes="Body" FontWeight="Bold" Margin="0,0,0,6" />
                                                                <WrapPanel>
                                                                    <CheckBox Content="Ranked" IsChecked="{Binding IncludeRanked}" Margin="0,0,16,4" />
                                                                    <CheckBox Content="Approved" IsChecked="{Binding IncludeApproved}" Margin="0,0,16,4" />
                                                                    <CheckBox Content="Qualified" IsChecked="{Binding IncludeQualified}" Margin="0,0,16,4" />
                                                                    <CheckBox Content="Loved" IsChecked="{Binding IncludeLoved}" />
                                                                </WrapPanel>
                                                            </StackPanel>
                                                        </Border>

                                                        <!-- Modes sub-card -->
                                                        <Border Background="#15FFFFFF" CornerRadius="8" Padding="12">
                                                            <StackPanel>
                                                                <TextBlock Text="Modes" Classes="Body" FontWeight="Bold" Margin="0,0,0,6" />
                                                                <WrapPanel>
                                                                    <CheckBox Content="osu!" IsChecked="{Binding OsuMode}" Margin="0,0,16,4" />
                                                                    <CheckBox Content="osu!taiko" IsChecked="{Binding TaikoMode}" Margin="0,0,16,4" />
                                                                    <CheckBox Content="osu!catch" IsChecked="{Binding CatchMode}" Margin="0,0,16,4" />
                                                                    <CheckBox Content="osu!mania" IsChecked="{Binding ManiaMode}" />
                                                                </WrapPanel>
                                                            </StackPanel>
                                                        </Border>

                                                        <!-- Mania Key Count sub-card -->
                                                        <Border Background="#15FFFFFF" CornerRadius="8" Padding="12"
                                                                IsVisible="{Binding IsManiaSelected}">
                                                            <StackPanel>
                                                                <TextBlock Text="Mania Key Count" Classes="Body" FontWeight="Bold" Margin="0,0,0,6" />
                                                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                                                    <TextBlock Text="Keys:" VerticalAlignment="Center" Classes="Body" />
                                                                    <Slider Grid.Column="1" Minimum="1" Maximum="18"
                                                                            Value="{Binding ManiaKeyCount}" />
                                                                    <TextBlock Grid.Column="2" Text="{Binding ManiaKeyCount}"
                                                                               VerticalAlignment="Center" Classes="Body" FontWeight="Bold" MinWidth="20" />
                                                                </Grid>
                                                            </StackPanel>
                                                        </Border>

                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Extra prompt overlay -->
                        <Border Grid.ColumnSpan="2" IsVisible="{Binding SyncVm.ShowExtraPrompt}"
                                Background="#B0000000" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                            <Border Classes="Card" HorizontalAlignment="Center" VerticalAlignment="Center"
                                    MaxWidth="400" Padding="24">
                                <StackPanel>
                                    <TextBlock Text="Extra Beatmaps Detected" Classes="H2" Margin="0,0,0,10" />
                                    <TextBlock Text="{Binding SyncVm.ExtraPromptMessage}" Classes="Body" TextWrapping="Wrap" />
                                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0" Spacing="10">
                                        <Button Content="Delete Extra" Classes="Danger" Command="{Binding SyncVm.DeleteExtraCommand}" />
                                        <Button Content="Keep" Classes="Secondary" Command="{Binding SyncVm.DismissExtraPromptCommand}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Border>
                    </Grid>
                    <Grid x:Name="ImportExportView" IsVisible="False" ColumnDefinitions="200,*" ColumnSpacing="16">

                        <Border Grid.Column="0" Classes="SidebarCard" VerticalAlignment="Stretch">
                            <StackPanel>
                                <Button x:Name="IeImportBtn" Content="Import" Classes="NavButton Selected" Click="IeNav_Click" Tag="import" Margin="0,0,0,6" />
                                <Button x:Name="IeExportBtn" Content="Export" Classes="NavButton" Click="IeNav_Click" Tag="export" />
                            </StackPanel>
                        </Border>

                        <Grid Grid.Column="1">
                            <Grid x:Name="ImportMode" IsVisible="True" RowDefinitions="*,Auto">
                                <Border Grid.Row="0" Classes="Card" VerticalAlignment="Top">
                                    <StackPanel>
                                        <TextBlock Text="Import Collections" Classes="H2" Margin="0,0,0,10" />
                                        <TextBlock Text="Select a .txt or .zip file to import collections." Classes="Body" TextWrapping="Wrap" Margin="0,0,0,16" />
                                        <Border Background="#10FFFFFF" CornerRadius="8" Padding="20" BorderBrush="#18FFFFFF" BorderThickness="1">
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="?" FontSize="40" HorizontalAlignment="Center" Margin="0,0,0,10" />
                                                <Button Content="Browse Files..." Classes="Secondary" Command="{Binding ImportExportVm.BrowseImportFileCommand}" Margin="0,0,0,8" />
                                                <TextBlock Text="{Binding ImportExportVm.ImportFilePath}" Classes="Muted" TextWrapping="Wrap" MaxWidth="400" />
                                            </StackPanel>
                                        </Border>
                                        <TextBlock Text="{Binding ImportExportVm.ImportStatus}" Classes="Body" TextWrapping="Wrap"
                                                   Foreground="#FF6ECF" Margin="0,10,0,0"
                                                   IsVisible="{Binding ImportExportVm.ImportStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Row="1" Padding="0,16,0,0">
                                    <Button Content="Import" Classes="Primary" HorizontalAlignment="Right"
                                            Command="{Binding ImportExportVm.ImportCommand}"
                                            IsEnabled="{Binding !ImportExportVm.IsImporting}" />
                                </Border>
                            </Grid>

                            <Grid x:Name="ExportMode" IsVisible="False" RowDefinitions="*,Auto,Auto">
                                <Border Grid.Row="0" Classes="Card" VerticalAlignment="Stretch">
                                    <Grid RowDefinitions="Auto,*,Auto">
                                        <StackPanel Grid.Row="0" Margin="0,0,0,12">
                                            <TextBlock Text="Export Collections" Classes="H2" Margin="0,0,0,6" />
                                            <TextBlock Text="Select collections to export. Multi-select supported." Classes="Body" Margin="0,0,0,6" />
                                            <Button Content="Refresh List" Classes="Secondary" HorizontalAlignment="Left"
                                                    Command="{Binding ImportExportVm.LoadCollectionsCommand}" />
                                        </StackPanel>
                                        <ScrollViewer Grid.Row="1">
                                            <ListBox ItemsSource="{Binding ImportExportVm.Collections}" SelectionMode="Multiple">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:CollectionItem">
                                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                                            <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center" />
                                                            <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" FontSize="14" Foreground="White" />
                                                            <Border Grid.Column="2" Background="#15FFFFFF" CornerRadius="4" Padding="8,2">
                                                                <TextBlock Text="{Binding BeatmapCount, StringFormat={}{0} maps}" Classes="Muted" />
                                                            </Border>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </ScrollViewer>
                                        <TextBlock Grid.Row="2" Text="{Binding ImportExportVm.ExportStatus}" Classes="Body" TextWrapping="Wrap"
                                                   Foreground="#FF6ECF" Margin="0,6,0,0" />
                                    </Grid>
                                </Border>
                                <Border Grid.Row="1" Padding="0,16,0,0">
                                    <Button Content="Export..." Classes="Primary" HorizontalAlignment="Right"
                                            Command="{Binding ImportExportVm.ShowExportDialogCommand}"
                                            IsEnabled="{Binding !ImportExportVm.IsExporting}" />
                                </Border>                                 <Border Grid.Row="2" Classes="Card" IsVisible="{Binding ImportExportVm.ShowExportFormatDialog}"
                                         Background="#30FFFFFF" Margin="0,16,0,0">
                                     <StackPanel>
                                         <TextBlock Text="Choose Export Format" Classes="H2" Margin="0,0,0,12" />
                                         <TextBlock Text="Select the format for your collection export:" Classes="Body" Margin="0,0,0,16" />
                                         <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                             <Button Content="Cancel" Classes="Secondary"
                                                     Command="{Binding ImportExportVm.CancelExportDialogCommand}"
                                                     Margin="0,0,10,0" />
                                             <Button Content="Export as TXT" Classes="Secondary"
                                                     Command="{Binding ImportExportVm.ExportAsTxtCommand}"
                                                     Margin="0,0,10,0" />
                                             <Button Content="Export as ZIP" Classes="Primary"
                                                     Command="{Binding ImportExportVm.ExportAsZipCommand}" />
                                         </StackPanel>
                                     </StackPanel>
                                 </Border>
                            </Grid>
                        </Grid>
                    </Grid>

                    <!-- ============== SETTINGS VIEW ============== -->
                    <ScrollViewer x:Name="SettingsView" IsVisible="False">
                        <StackPanel MaxWidth="700">
                            <Border Classes="Card" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="osu! Installation Path" Classes="H2" Margin="0,0,0,10" />
                                    <TextBlock Text="Select your osu! lazer installation folder." Classes="Body" Margin="0,0,0,10" />
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                        <TextBox Text="{Binding SettingsVm.OsuInstallPath}" PlaceholderText="C:\Users\You\AppData\Local\osu" />
                                        <Button Grid.Column="1" Content="Browse..." Classes="Secondary" Command="{Binding SettingsVm.BrowseOsuPathCommand}" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Classes="Card" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="Download Threads" Classes="H2" Margin="0,0,0,10" />
                                    <TextBlock Text="Number of concurrent download threads." Classes="Body" Margin="0,0,0,10" />
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                        <TextBlock Text="{Binding SettingsVm.DownloadThreads}" Classes="Body" FontWeight="Bold" VerticalAlignment="Center" MinWidth="24" />
                                        <Slider Grid.Column="1" Width="200" Minimum="1" Maximum="16" Value="{Binding SettingsVm.DownloadThreads}" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <Border Classes="Card" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="Beatmap Database" Classes="H2" Margin="0,0,0,10" />
                                    <TextBlock Text="Select the .db file generated by fetch_catboy.py." Classes="Body" Margin="0,0,0,10" />
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                        <TextBox Text="{Binding SettingsVm.DatabasePath}" PlaceholderText="C:\path\to\catboy_ranked.db" />
                                        <Button Grid.Column="1" Content="Browse..." Classes="Secondary" Command="{Binding SettingsVm.BrowseDatabasePathCommand}" />
                                    </Grid>
                                    <TextBlock Margin="0,4,0,0" Classes="Muted"
                                               Text="{Binding SettingsVm.IsDatabaseReady, StringFormat='DB Ready: {0}'}" />
                                </StackPanel>
                            </Border>

                            <Border Classes="Card" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="Download Source" Classes="H2" Margin="0,0,0,10" />
                                    <TextBlock Text="Choose where to download beatmaps from." Classes="Body" Margin="0,0,0,10" />
                                    <RadioButton Content="Official (osu.ppy.sh) - Currently unavailable" IsEnabled="False" IsChecked="{Binding SettingsVm.UseOfficialSource}" Margin="0,0,0,6" />
                                    <RadioButton Content="Mirror (catboy.best)" IsChecked="{Binding SettingsVm.UseCatboyMirror}" />
                                </StackPanel>
                            </Border>


                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        

        <!-- Status Bar -->
        <Border VerticalAlignment="Bottom" Height="28" Background="#10000000" Padding="12,0">
            <TextBlock Text="{Binding StatusMessage}" Foreground="{Binding StatusForeground}" FontSize="12" VerticalAlignment="Center" />
        </Border>
    </Panel>
</Window>
