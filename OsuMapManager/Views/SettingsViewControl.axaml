<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:OsuMapManager.ViewModels"
             x:Class="OsuMapManager.Views.SettingsViewControl"
             x:DataType="vm:MainViewModel">
<ScrollViewer >
                        <StackPanel MaxWidth="700">
                            <Border Classes="Card" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="osu! Installation Path" Classes="H2" Margin="0,0,0,10" />
                                    <TextBlock Text="Select your osu! lazer installation folder." Classes="Body" Margin="0,0,0,10" />
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                        <TextBox Text="{Binding SettingsVm.OsuInstallPath}" PlaceholderText="C:\Users\You\AppData\Local\osu" />
                                        <Button Grid.Column="1" Content="Browse..." Classes="Secondary" Command="{Binding SettingsVm.BrowseOsuPathCommand}" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Classes="Card" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="Download Path" Classes="H2" Margin="0,0,0,10" />
                                    <TextBlock Text="Folder where downloaded .osz files will be saved." Classes="Body" Margin="0,0,0,10" />
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                        <TextBox Text="{Binding SettingsVm.DownloadPath}" PlaceholderText="Defaults to app directory\downloads" />
                                        <Button Grid.Column="1" Content="Browse..." Classes="Secondary" Command="{Binding SettingsVm.BrowseDownloadPathCommand}" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Classes="Card" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="Download Threads" Classes="H2" Margin="0,0,0,10" />
                                    <TextBlock Text="Number of concurrent download threads." Classes="Body" Margin="0,0,0,10" />
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                        <TextBlock Text="{Binding SettingsVm.DownloadThreads}" Classes="Body" FontWeight="Bold" VerticalAlignment="Center" MinWidth="24" />
                                        <Slider Grid.Column="1" Width="200" Minimum="1" Maximum="8" Value="{Binding SettingsVm.DownloadThreads}" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <Border Classes="Card" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="Beatmap Database" Classes="H2" Margin="0,0,0,10" />
                                    <TextBlock Text="Select the .db file generated by fetch_catboy.py." Classes="Body" Margin="0,0,0,10" />
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                        <TextBox Text="{Binding SettingsVm.DatabasePath}" PlaceholderText="C:\path\to\catboy_ranked.db" />
                                        <Button Grid.Column="1" Content="Browse..." Classes="Secondary" Command="{Binding SettingsVm.BrowseDatabasePathCommand}" />
                                    </Grid>
                                    <TextBlock Margin="0,4,0,0" Classes="Muted"
                                               Text="{Binding SettingsVm.IsDatabaseReady, StringFormat='DB Ready: {0}'}" />
                                </StackPanel>
                            </Border>

                            <Border Classes="Card" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="Download Source" Classes="H2" Margin="0,0,0,10" />
                                    <TextBlock Text="Choose where to download beatmaps from." Classes="Body" Margin="0,0,0,10" />
                                    <RadioButton Content="Official (osu.ppy.sh) - Currently unavailable" IsEnabled="False" IsChecked="{Binding SettingsVm.UseOfficialSource}" Margin="0,0,0,6" />
                                    <RadioButton Content="Mirror (catboy.best)" IsChecked="{Binding SettingsVm.UseCatboyMirror}" />
                                </StackPanel>
                            </Border>

                            <Border Classes="Card" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="Local Query" Classes="H2" Margin="0,0,0,10" />
                                    <TextBlock Text="When enabled, local queries cross-reference the Map Database to fill in Genre information." Classes="Body" Margin="0,0,0,10" />
                                    <CheckBox Content="Enable genre lookup from Map Database"
                                              IsChecked="{Binding SettingsVm.EnableLocalGenreLookup}" />
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>
</UserControl>

