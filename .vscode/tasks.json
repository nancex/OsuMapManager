{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "command": "dotnet",
            "type": "process",
            "args": [
                "build",
                "${workspaceFolder}/OsuMapManager/OsuMapManager.csproj",
                "-c", "Debug",
                "-r", "win-x64",
                "--self-contained", "false",
                "/p:AvaloniaBuildServicesEnabled=false"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$msCompile",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "env": {
                "AVALONIA_TELEMETRY_OPTOUT": "1"
            }
        }
    ]
}
